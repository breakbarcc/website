# Impressum / Datenschutz contact data.
# Copy this file to .env.local for local development (gitignored via *.local)
# and set the same keys as Environment Variables in the Vercel project
# settings (Production + Preview + Development) so they get baked into the
# build without ever being committed to the repo.

VITE_LEGAL_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_CITY=
VITE_LEGAL_EMAIL=
VITE_LEGAL_SECONDARY_CONTACT=
VITE_LEGAL_HOSTING_PROVIDER=
